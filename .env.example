# ---- Public (safe for the browser) ----
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Your deployed address, used in links shown in the dashboard (widget snippet, invitations, webhook URL)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---- Server only: never expose in browser code or commit ----
# Needed by the website widget and the Selar webhook (they act without a logged in user)
SUPABASE_SERVICE_ROLE_KEY=
# AI providers: set at least one. Agents cannot reply without a key for their chosen provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Shared secret Selar sends with payment webhooks (any long random string you choose)
SELAR_WEBHOOK_SECRET=
